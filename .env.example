# ===========================
# APP
# ===========================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ===========================
# BOT WHATSAPP
# ===========================
BOT_NAME=TopUpBot
BOT_OWNER=6281234567890
SESSION_PATH=./src/sessions

# ===========================
# DATABASE
# ===========================
DATABASE_PATH=./data/bot.db

# ===========================
# ATLANTIC H2H
# ===========================
ATLANTIC_API_KEY=your_atlantic_api_key
ATLANTIC_BASE_URL=https://api.atlantich2h.com
ATLANTIC_USERNAME=your_atlantic_username
ATLANTIC_PASSWORD=your_atlantic_password
ATLANTIC_RETRY_ATTEMPTS=3
ATLANTIC_RETRY_DELAY=1000

# ===========================
# QIOSPAY
# ===========================
QIOSPAY_API_KEY=your_qiospay_api_key
QIOSPAY_MERCHANT_ID=your_merchant_id
QIOSPAY_SECRET=your_qiospay_secret
QIOSPAY_BASE_URL=https://qiospay.id
QIOSPAY_WEBHOOK_SECRET=your_webhook_secret
QIOSPAY_WEBHOOK_URL=https://your-domain.com/webhook/qiospay

# ===========================
# SECURITY
# ===========================
JWT_SECRET=your_super_secret_key_here
ADMIN_PIN=1234

# ===========================
# RATE LIMITING
# ===========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# ===========================
# MONITORING
# ===========================
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_INTERVAL=30000
ENABLE_ORDER_CHECK_SCHEDULER=true
ORDER_CHECK_INTERVAL=300000
